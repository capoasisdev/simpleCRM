{
  "appId": "com.capoasis.crm",
  "appName": "SimpleCRM",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "simplecrm.capoasis.com"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#09090b",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
