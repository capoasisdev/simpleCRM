{
  "appId": "com.capoasis.crm",
  "appName": "SimpleCRM",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#09090b",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f3f4f4",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
